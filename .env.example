# MongoDB Connection (Falls back seamlessly to local persistent store if not specified)
MONGO_URI="mongodb://localhost:27017/jharna_clinic"

# JWT Secret for secure Admin authentication
JWT_SECRET="jharna_clinic_super_secret_jwt_key_2026"

# Application URL
APP_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"
PORT=3000

# Gemini AI / LLM Configuration for Jharna Care Assistant
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_API_KEY="MY_GEMINI_API_KEY"
AI_MODEL="gemini-3.8-flash"

# Initial Admin Credentials (Editable in Admin Settings)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# Optional Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

